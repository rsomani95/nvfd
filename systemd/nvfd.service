[Unit]
Description=NVFD - NVIDIA Fan Daemon
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service
# A fan daemon must never give up — keep retrying so the GPUs are never left uncontrolled.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/nvfd
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5

# Security hardening
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/etc/nvfd
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# ProtectClock removed: it injects an implicit DeviceAllow=char-rtc which, under
# DevicePolicy=auto, turns device access into a whitelist that blocks /dev/nvidia*
# — nvmlInit() then fails and the daemon crash-loops (status=1, never activates at boot).
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
ProtectHostname=yes

[Install]
WantedBy=multi-user.target
